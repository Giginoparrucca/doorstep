    "openapi_reservations_save.json": {
      "sourceUrl": "https://www.ireservation.it/docs/conf/openapi_reservations_save.json",
      "sourceSha256": "5fa044d5a9648f50bee51963e896a7466aa87bca5edb8b3b6d0d7bc0117ce32e",
      "definition": {
        "post": {
          "summary": "Reservation save",
          "description": "Creates, updates or deletes a direct reservation (idDistributor = 0) on the calendar of a property.\n\nThe operation to perform is selected with the `action` field:\n* `I` insert a new reservation. The `idReservation` field must be omitted.\n* `U` update an existing reservation. The `idReservation` field is required and the reservation is fully replaced with the data provided in the request.\n* `D` delete an existing reservation. Only the `idReservation` field is required, every other reservation field is ignored.\n\nThe `id` of each room must be one of the ids returned by the /rooms endpoint. The availability of the calendar is decreased automatically for every night of the stay, and it is restored when the reservation is updated or deleted. If one of the requested rooms has no availability the whole request is rejected and nothing is saved.\n\nThe endpoint is available only for the properties whose channel manager is active.",
          "tags": [
            "Reservations"
          ],
          "operationId": "reservationsSave",
          "parameters": [],
          "security": {
            "Bearer": [],
            "ApiKey": []
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lang": {
                      "type": "string",
                      "enum": [
                        "en",
                        "it",
                        "fr",
                        "de",
                        "es"
                      ]
                    },
                    "parameters": {
                      "type": "object",
                      "required": [
                        "calendarId",
                        "propertyUsername",
                        "propertyPassword",
                        "action"
                      ],
                      "properties": {
                        "calendarId": {
                          "type": "integer"
                        },
                        "propertyUsername": {
                          "type": "string"
                        },
                        "propertyPassword": {
                          "type": "string"
                        },
                        "action": {
                          "type": "string",
                          "enum": [
                            "I",
                            "U",
                            "D"
                          ],
                          "description": "I = Insert, U = Update, D = Delete"
                        },
                        "idReservation": {
                          "type": "string",
                          "nullable": true,
                          "description": "Required when action is 'U' or 'D'. It must be the idReservation returned by the /reservations endpoint. It must be omitted when action is 'I'."
                        },
                        "guestFirstName": {
                          "type": "string",
                          "description": "Required when action is 'I' or 'U'."
                        },
                        "guestLastName": {
                          "type": "string",
                          "description": "Required when action is 'I' or 'U'."
                        },
                        "guestEmail": {
                          "type": "string",
                          "nullable": true
                        },
                        "guestPhoneNumber": {
                          "type": "string",
                          "nullable": true
                        },
                        "dateCheckIn": {
                          "type": "string",
                          "format": "date",
                          "description": "Required when action is 'I' or 'U'. The format is: 'YYYY-MM-DD'"
                        },
                        "dateCheckOut": {
                          "type": "string",
                          "format": "date",
                          "description": "Required when action is 'I' or 'U'. It must be later than dateCheckIn and the stay cannot be longer than 30 nights. The format is: 'YYYY-MM-DD'"
                        },
                        "hostNotes": {
                          "type": "string",
                          "nullable": true,
                          "description": "Private notes of the property, they are never shown to the guest."
                        },
                        "rooms": {
                          "type": "array",
                          "description": "Required when action is 'I' or 'U'. The same room can be sent more than once to book more than one unit of the same room type.",
                          "items": {
                            "type": "object",
                            "required": [
                              "id"
                            ],
                            "properties": {
                              "id": {
                                "type": "integer",
                                "description": "The id of the room, as returned by the /rooms endpoint."
                              },
                              "numberAdults": {
                                "type": "integer"
                              },
                              "numberChildren": {
                                "type": "integer",
                                "description": "Guests less than 18 years old"
                              },
                              "price": {
                                "type": "number",
                                "description": "Total price of the room for the whole stay. The price of the reservation is the sum of the prices of its rooms."
                              }
                            }
                          }
                        },
                        "idDistributor": {
                          "type": "integer",
                          "nullable": true,
                          "description": "Only direct reservations can be managed with this endpoint, so the only accepted value is 0. If omitted it defaults to 0."
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "The saved reservation",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "results": {
                        "properties": {
                          "reservation": {
                            "type": "object",
                            "properties": {
                              "idReservation": {
                                "type": "string"
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "I",
                                  "U",
                                  "D"
                                ],
                                "description": "I = Inserted, U = Updated, D = Deleted"
                              },
                              "guestFirstName": {
                                "type": "string"
                              },
                              "guestLastName": {
                                "type": "string"
                              },
                              "guestEmail": {
                                "type": "string",
                                "nullable": true
                              },
                              "guestPhoneNumber": {
                                "type": "string",
                                "nullable": true
                              },
                              "guestCountry": {
                                "type": "string",
                                "nullable": true,
                                "description": "Country of the guest in ISO-3166 format"
                              },
                              "guestLanguage": {
                                "type": "string",
                                "nullable": true,
                                "description": "Language of the guest in two letter format"
                              },
                              "dateCheckIn": {
                                "type": "string",
                                "format": "date",
                                "description": "The format is: 'YYYY-MM-DD'"
                              },
                              "dateCheckOut": {
                                "type": "string",
                                "format": "date",
                                "description": "The format is: 'YYYY-MM-DD'"
                              },
                              "dateTimeLastUpdate": {
                                "type": "string",
                                "format": "date",
                                "description": "The last time the reservation has been updated. It could be the same datetime the reservation has been created. The format is: 'YYYY-MM-DD HH:mm:ss'"
                              },
                              "numberAdults": {
                                "type": "integer"
                              },
                              "numberChildren": {
                                "type": "integer",
                                "description": "Guests less than 18 years old"
                              },
                              "price": {
                                "type": "number"
                              },
                              "priceBreakdown": {
                                "type": "object",
                                "properties": {
                                  "onlyRooms": {
                                    "type": "number"
                                  },
                                  "touristTax": {
                                    "type": "number"
                                  },
                                  "petFee": {
                                    "type": "number"
                                  },
                                  "cleaningFee": {
                                    "type": "number"
                                  },
                                  "otherFee": {
                                    "type": "number"
                                  }
                                }
                              },
                              "idDistributor": {
                                "type": "integer"
                              },
                              "nameDistributor": {
                                "type": "string"
                              },
                              "rooms": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "id": {
                                      "type": "integer"
                                    },
                                    "name": {
