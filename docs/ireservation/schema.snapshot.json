      "definition": {
        "openapi": "3.0.0",
        "info": {
          "title": "iReservation.it API",
          "version": "1.3.0",
          "description": "This API allows partners to seamlessly integrate with the iReservation.it platform, enabling access to data about reservations and rooms of a property.\n\n### 🚀 To get started:\n1. **Request your credentials** by contacting us at [info@ireservation.it](mailto:info@ireservation.it).\n2. **Authenticate** using the `/v1/oauth2/authorizations` endpoint to obtain your access token.\n3. **Use apis** ensure you include your API key in every request using the `x-api-key` header, and authenticate with the `Authorization: Bearer {token}` header.\n\n➡️ **[Download the API guide - IT version (PDF)](https://www.ireservation.it/docs/integration_guide_it.pdf)**\n\n➡️ **[Download the API guide - EN version (PDF)](https://www.ireservation.it/docs/integration_guide_en.pdf)**\n\nHappy coding!"
        },
        "servers": [
          {
            "url": "https://api.ireservation.it"
          }
        ],
        "paths": {
          "/v1/oauth2/authorizations": {
            "$ref": "./openapi_authorizations.json"
          },
          "/distributors": {
            "$ref": "./openapi_distributors.json"
          },
          "/rooms": {
            "$ref": "./openapi_rooms.json"
          },
          "/reservations": {
            "$ref": "./openapi_reservations.json"
          },
          "/reservations/save": {
            "$ref": "./openapi_reservations_save.json"
          }
        },
        "components": {
          "securitySchemes": {
            "Bearer": {
              "type": "http",
              "scheme": "bearer",
              "bearerFormat": "JWT"
            },
            "ApiKey": {
              "type": "apiKey",
              "in": "header",
              "name": "x-api-key"
            }
          }
        }
      }
    },
    "openapi_authorizations.json": {
      "sourceUrl": "https://www.ireservation.it/docs/conf/openapi_authorizations.json",
      "sourceSha256": "93b8776e5e5aa577775c8b4955413356e70bbc586800f7899514b41a8dbfc318",
      "definition": {
        "post": {
          "summary": "Get an access token",
          "description": "OAuth2 authentication to obtain an access token using username and password, or to refresh the token after expiration.",
          "tags": [
            "Authorization"
          ],
          "operationId": "authorizeUser",
          "parameters": [],
          "security": {
            "ApiKey": []
          },
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "username",
                        "password"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "refreshToken": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "refreshToken"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Token successfully obtained",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "integer"
                      },
                      "message": {
                        "type": "string"
                      },
                      "result": {
                        "type": "object",
                        "properties": {
                          "expiresIn": {
                            "type": "integer"
                          },
                          "token": {
                            "type": "string"
                          },
                          "refreshToken": {
                            "type": "string",
                            "nullable": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "$ref": "./openapi_exceptions.json#/UnauthorizedError"
            },
            "429": {
              "$ref": "./openapi_exceptions.json#/TooManyRequestsError"
            },
            "500": {
              "$ref": "./openapi_exceptions.json#/InternalServerError"
            }
