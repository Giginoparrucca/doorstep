{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "rewrites": [
    {
      "source": "/api/guest-chat",
      "destination": "/api/guest"
    }
  ],
  "crons": [
    {
      "path": "/api/ical-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/send-arrival-reminders",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/alloggiati.js": {
      "includeFiles": "lib/**",
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 60
    }
  }
}
